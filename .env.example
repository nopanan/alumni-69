NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:5173

# Use supabase when connecting through the API (no direct DB password/tenant needed).
# Install db/setup-api.sql and db/supabase-api.sql in the Studio SQL editor first.
DATABASE_TRANSPORT=supabase

# Only needed when DATABASE_TRANSPORT=postgres.
# PostgreSQL connection string; NOT the Studio URL/Basic username/password.
# Use sslmode=verify-full and a trusted CA for a remote TLS connection.
# Supavisor session pooler requires DB_USER.POOLER_TENANT_ID as the username.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
DB_POOL_MAX=10

# Kong/API base URL, which may differ from the Studio port.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SLIP_BUCKET=alumni69-slips

# Generate with: npm run keygen
SESSION_ENCRYPTION_KEY=
SESSION_TTL_SECONDS=28800

LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_REDIRECT_URI=http://localhost:3000/auth/line/callback
LINE_OA_ADD_FRIEND_URL=
LINE_GROUP_INVITE_URL=
# Keep the original pre-booking requirements until the owner changes them.
REQUIRE_LINE_OA_FRIEND=true
REQUIRE_LINE_GROUP_ACK=true
