      "name": "table_status",
      "options": [
        "security_invoker=true"
      ],
      "definition": " SELECT t.id,\n    t.zone,\n    t.column_label,\n    t.table_number,\n    t.kind,\n    t.price,\n    t.seats,\n        CASE\n            WHEN t.kind = 'staff'::text THEN 'blocked'::text\n            WHEN b.status = 'confirmed'::text THEN 'confirmed'::text\n            WHEN b.status = 'pending_review'::text THEN 'pending_review'::text\n            WHEN b.status = 'pending_payment'::text AND b.expires_at > now() THEN 'pending_payment'::text\n            ELSE 'available'::text\n        END AS status,\n        CASE\n            WHEN t.kind = 'staff'::text THEN 'gray-black'::text\n            WHEN b.status = 'confirmed'::text THEN 'red'::text\n            WHEN b.status = 'pending_review'::text OR b.status = 'pending_payment'::text AND b.expires_at > now() THEN 'orange'::text\n            ELSE 'white'::text\n        END AS color\n   FROM alumni_69.event_tables t\n     LEFT JOIN alumni_69.table_claims c ON c.table_id = t.id\n     LEFT JOIN alumni_69.bookings b ON b.id = c.booking_id;"
    },
    {
      "acl": [
        "postgres=arwdDxtm/postgres",
        "service_role=r/postgres"
      ],
      "name": "booking_summary",
      "options": [
        "security_invoker=true"
      ],
      "definition": " SELECT count(*) FILTER (WHERE status = 'confirmed'::text) AS confirmed_tables,\n    count(*) FILTER (WHERE status = ANY (ARRAY['pending_payment'::text, 'pending_review'::text])) AS pending_tables,\n    count(*) FILTER (WHERE status = 'available'::text) AS available_tables,\n    count(*) FILTER (WHERE status = 'confirmed'::text) * 3500 AS confirmed_amount,\n    count(*) FILTER (WHERE status = ANY (ARRAY['pending_payment'::text, 'pending_review'::text])) * 3500 AS pending_amount,\n    count(*) FILTER (WHERE status = 'available'::text) * 3500 AS available_amount\n   FROM alumni_69.table_status\n  WHERE kind = 'regular'::text;"
    }
