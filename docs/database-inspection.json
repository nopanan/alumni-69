      "definition": "CREATE OR REPLACE FUNCTION alumni_69.expire_bookings()\n RETURNS integer\n LANGUAGE plpgsql\n SET search_path TO ''\nAS $function$\nDECLARE n integer;\nBEGIN\n PERFORM pg_advisory_xact_lock(690035008::bigint);\n WITH expired AS (\n UPDATE alumni_69.bookings SET status='expired' WHERE status='pending_payment' AND expires_at<=clock_timestamp() RETURNING id\n ) DELETE FROM alumni_69.table_claims WHERE booking_id IN (SELECT id FROM expired);\n GET DIAGNOSTICS n=ROW_COUNT; RETURN n;\nEND $function$\n"
    },
    {
      "acl": [
        "postgres=X/postgres",
        "service_role=X/postgres"
      ],
      "name": "create_booking",
      "definition": "CREATE OR REPLACE FUNCTION alumni_69.create_booking(p_customer uuid, p_name text, p_phone text, p_tables text[])\n RETURNS uuid\n LANGUAGE plpgsql\n SET search_path TO ''\nAS $function$\nDECLARE bid uuid; n integer;\nBEGIN\n PERFORM pg_advisory_xact_lock(690035008::bigint);\n PERFORM alumni_69.expire_bookings();\n n:=cardinality(p_tables);\n IF n IS NULL OR n=0 OR n<>(SELECT count(DISTINCT x) FROM unnest(p_tables) x) THEN RAISE EXCEPTION 'Select unique table IDs'; END IF;\n IF n<>(SELECT count(*) FROM alumni_69.event_tables WHERE id=ANY(p_tables) AND kind='regular') THEN RAISE EXCEPTION 'Invalid or unavailable table type'; END IF;\n IF EXISTS(SELECT 1 FROM alumni_69.table_claims WHERE table_id=ANY(p_tables)) THEN RAISE EXCEPTION 'Table already reserved' USING ERRCODE='23505'; END IF;\n INSERT INTO alumni_69.bookings(customer_id,booker_name,phone,total_amount,expires_at)\n VALUES(p_customer,p_name,p_phone,n*3500,clock_timestamp()+interval '1 hour') RETURNING id INTO bid;\n INSERT INTO alumni_69.booking_items SELECT bid,x,3500 FROM unnest(p_tables) x;\n INSERT INTO alumni_69.table_claims SELECT x,bid FROM unnest(p_tables) x;\n RETURN bid;\nEND $function$\n"
    },
    {
      "acl": [
        "postgres=X/postgres",
        "service_role=X/postgres"
      ],
      "name": "submit_slip",
      "definition": "CREATE OR REPLACE FUNCTION alumni_69.submit_slip(p_customer uuid, p_booking uuid, p_slip_path text)\n RETURNS uuid\n LANGUAGE plpgsql\n SET search_path TO ''\nAS $function$\nDECLARE pid uuid;\nBEGIN\n PERFORM pg_advisory_xact_lock(690035008::bigint);\n PERFORM alumni_69.expire_bookings();\n UPDATE alumni_69.bookings SET status='pending_review' WHERE id=p_booking AND customer_id=p_customer AND status='pending_payment' AND expires_at>clock_timestamp();\n IF NOT FOUND THEN RAISE EXCEPTION 'Booking expired, not owned, or not awaiting payment'; END IF;\n INSERT INTO alumni_69.payments(booking_id,slip_path) VALUES(p_booking,p_slip_path) RETURNING id INTO pid;\n RETURN pid;\nEND $function$\n"
    },
    {
      "acl": [
        "postgres=X/postgres",
        "service_role=X/postgres"
      ],
      "name": "confirm_payment",
      "definition": "CREATE OR REPLACE FUNCTION alumni_69.confirm_payment(p_booking uuid, p_actor uuid)\n RETURNS void\n LANGUAGE plpgsql\n SET search_path TO ''\nAS $function$\nBEGIN\n PERFORM pg_advisory_xact_lock(690035008::bigint);\n IF NOT EXISTS(SELECT 1 FROM alumni_69.staff_accounts WHERE auth_user_id=p_actor AND role IN ('admin','staff')) THEN RAISE EXCEPTION 'Reviewer not authorized'; END IF;\n IF EXISTS(SELECT 1 FROM alumni_69.bookings WHERE id=p_booking AND status='confirmed') THEN RETURN; END IF;\n IF NOT EXISTS(SELECT 1 FROM alumni_69.payments WHERE booking_id=p_booking AND status='pending') THEN RAISE EXCEPTION 'No pending slip'; END IF;\n UPDATE alumni_69.bookings SET status='confirmed',confirmed_at=clock_timestamp(),confirmed_by=p_actor WHERE id=p_booking AND status='pending_review';\n IF NOT FOUND THEN RAISE EXCEPTION 'Booking not awaiting review'; END IF;\n UPDATE alumni_69.payments SET status='approved',reviewed_by=p_actor,reviewed_at=clock_timestamp() WHERE booking_id=p_booking AND status='pending';\n INSERT INTO alumni_69.tickets(booking_id,table_id,seat_number) SELECT i.booking_id,i.table_id,n FROM alumni_69.booking_items i CROSS JOIN generate_series(1,8) n WHERE i.booking_id=p_booking;\n INSERT INTO alumni_69.notification_outbox(booking_id,kind) VALUES(p_booking,'tickets_ready') ON CONFLICT DO NOTHING;\nEND $function$\n"
    },
    {
      "acl": [
        "postgres=X/postgres",
        "service_role=X/postgres"
      ],
      "name": "record_login",
      "definition": "CREATE OR REPLACE FUNCTION alumni_69.record_login(p_line_id text, p_display_name text, p_picture_url text DEFAULT NULL::text)\n RETURNS uuid\n LANGUAGE plpgsql\n SET search_path TO ''\nAS $function$\nDECLARE cid uuid;\nBEGIN\n INSERT INTO alumni_69.customers(line_user_id,display_name,picture_url) VALUES(p_line_id,p_display_name,p_picture_url)\n ON CONFLICT(line_user_id) DO UPDATE SET display_name=excluded.display_name,picture_url=excluded.picture_url,last_login_at=clock_timestamp() RETURNING id INTO cid;\n INSERT INTO alumni_69.login_history(customer_id) VALUES(cid); RETURN cid;\nEND $function$\n"
    }
