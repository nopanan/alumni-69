{
  "name": "alumni-69-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.16" },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:integration": "node --test --test-concurrency=1 test/integration.test.js",
    "db:setup": "node --env-file-if-exists=.env scripts/setup-db.js",
    "storage:setup": "node --env-file-if-exists=.env scripts/setup-storage.js",
    "staff:setup": "node --env-file-if-exists=.env scripts/provision-staff.js",
    "demo": "node scripts/demo.js",
    "keygen": "node -e \"console.log(require('node:crypto').randomBytes(32).toString('hex'))\""
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/multipart": "10.1.7",
    "@fastify/rate-limit": "11.2.2",
    "@supabase/supabase-js": "2.119.0",
    "fastify": "5.12.8",
    "pg": "8.23.1"
  },
  "devDependencies": { "embedded-postgres": "17.11.0-beta.19" }
}
